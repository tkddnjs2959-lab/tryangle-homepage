# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#
# tryangle-research 와 같은 Supabase 프로젝트를 그대로 씁니다.
# 문의 폼이 그 프로젝트의 inquiries 테이블에 저장되고,
# 어드민(tryangle-research/admin/inquiries)에서 확인합니다.
#
# 값 찾는 곳:
#   https://supabase.com/dashboard/project/xvpqjawckzdkzkohhbdg/settings/api-keys

SUPABASE_URL=https://xvpqjawckzdkzkohhbdg.supabase.co

# service_role 키. RLS 를 우회하는 마스터 키 — 서버에서만 쓰이고 브라우저로 나가지 않는다.
# tryangle-research/.env.local 에 이미 넣어둔 것과 같은 값을 그대로 쓰면 된다.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# 문의 접수 알림 메일
# ---------------------------------------------------------------------
# https://resend.com 무료 가입 → API Keys 에서 발급 (재발급 시 re_ 로 시작)
RESEND_API_KEY=

# 알림을 받을 이메일. Resend 무료 티어의 기본 발신 도메인은
# "가입할 때 쓴 이메일"로만 보낼 수 있으므로, 이 값은 Resend 가입 이메일과
# 같아야 한다. (커스텀 도메인을 인증하면 이 제한이 없어진다.)
ADMIN_EMAIL=

# ---------------------------------------------------------------------
# 문의 접수 알림 카카오톡 ("나에게 보내기")
# ---------------------------------------------------------------------
# https://developers.kakao.com → 앱 만들기 → 앱 설정 > 앱 키 에서 REST API 키 확인
KAKAO_REST_API_KEY=

# 카카오 로그인 활성화 후, 앱 설정 > 카카오 로그인 > Redirect URI 에
# 아래와 똑같은 값을 등록해야 한다 (한 글자도 다르면 안 됨).
#   로컬 테스트: http://localhost:3100/api/kakao/callback
#   실서비스 배포 후: https://실제도메인/api/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:3100/api/kakao/callback

# 선택. 앱 설정에서 '보안 > Client Secret' 을 활성화했다면 그 값을 넣는다.
# 활성화하지 않았다면 비워둔다.
KAKAO_CLIENT_SECRET=

# 위 셋을 채운 뒤, 브라우저로 아래 주소에 딱 한 번 접속해서
# 본인 카카오 계정으로 동의하면 연동이 끝난다 (이후 자동):
#   http://localhost:3100/api/kakao/authorize

